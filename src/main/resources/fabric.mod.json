{
	"schemaVersion": 1,
	"id": "rubymod",
	"version": "${version}",
	"name": "Ruby Wars",
	"description": "A two-week modern-warfare season: build your base for 14 days, then survive Battle Day.",
	"authors": [
		"gregr"
	],
	"license": "CC0-1.0",
	"icon": "assets/rubymod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.rubymod.RubyMod"
		],
		"client": [
			"dev.rubymod.client.RubyModClient"
		],
		"voicechat": [
			"dev.rubymod.voice.RadioPlugin"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		"rubymod.mixins.json",
		{
			"config": "rubymod.client.mixins.json",
			"environment": "client"
		}
	],
	"suggests": {
		"voicechat": "*"
	}
}